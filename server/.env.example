# =====================================================================================
# App Parejas - variables del stack Supabase self-hosted  (PLANTILLA SIN SECRETOS)
#
# Se basa en el .env.example del docker/ oficial de Supabase (misma lista de claves) con
# valores de la pareja. En el VPS el archivo real vive en:
#     /opt/app-parejas/secrets/.env        (chmod 600; NUNCA se sube al repo)
# y /opt/app-parejas/stack/.env es un symlink a ese archivo.
#
# Todo valor que empieza con CAMBIAR_ debe reemplazarse. scripts/server/lib.sh se niega a
# continuar si queda alguno. La forma más rápida de generar los secretos es el script
# oficial (desde /opt/app-parejas/stack):    sh utils/generate-keys.sh --update-env
# Abajo se explica cómo hacerlo a mano con openssl.
# =====================================================================================

# --- Proyecto compose / archivos ---------------------------------------------------------
# Así `docker compose` manual dentro de stack/ también usa el proyecto y los archivos correctos.
COMPOSE_PROJECT_NAME=app-parejas
COMPOSE_FILE=docker-compose.yml:docker-compose.override.yml

# --- Opciones de App Parejas (las lee scripts/server/lib.sh; Docker las ignora) ----------
# Gateway: "envoy" (default oficial, ligero) o "kong" (agrega docker-compose.kong.yml).
STACK_GATEWAY=envoy
# Analytics (Logflare) + Vector: apagados para ahorrar RAM. "true" los enciende.
STACK_LOGS=false
# Supavisor (pooler de Postgres): apagado; la app no lo necesita. "true" lo enciende (solo loopback).
STACK_POOLER=false

# =====================================================================================
# Secretos  (CAMBIAR TODOS antes del primer arranque)
# =====================================================================================

# Contraseña de Postgres. Sin caracteres raros (@ : / ? # %) porque va dentro de URLs.
#   openssl rand -hex 24
POSTGRES_PASSWORD=CAMBIAR_postgres_password

# Secreto para firmar los JWT (HS256), mínimo 32 caracteres.
#   openssl rand -base64 30
JWT_SECRET=CAMBIAR_jwt_secret

# ANON_KEY y SERVICE_ROLE_KEY son JWT HS256 FIRMADOS con JWT_SECRET (no son aleatorios).
# Si cambias JWT_SECRET hay que regenerarlos (y actualizar la app / GitHub Secrets).
# Payload: {"role":"anon"|"service_role","iss":"supabase","iat":<ahora>,"exp":<ahora + 5 años>}
# Generación a mano (bash, con JWT_SECRET ya definido en la variable $JWT_SECRET):
#   b64() { openssl enc -base64 -A | tr '+/' '-_' | tr -d '='; }
#   sign() { h=$(printf %s '{"alg":"HS256","typ":"JWT"}' | b64); p=$(printf %s "$1" | b64);
#            s=$(printf %s "$h.$p" | openssl dgst -binary -sha256 -hmac "$JWT_SECRET" | b64);
#            printf '%s.%s.%s\n' "$h" "$p" "$s"; }
#   iat=$(date +%s); exp=$((iat + 5*365*24*3600))
#   sign "{\"role\":\"anon\",\"iss\":\"supabase\",\"iat\":$iat,\"exp\":$exp}"          # ANON_KEY
#   sign "{\"role\":\"service_role\",\"iss\":\"supabase\",\"iat\":$iat,\"exp\":$exp}"  # SERVICE_ROLE_KEY
# (utils/generate-keys.sh del repo oficial hace exactamente esto.)
# ANON_KEY es pública (va en la app). SERVICE_ROLE_KEY NUNCA va en la app ni en el repo.
ANON_KEY=CAMBIAR_anon_key_jwt
SERVICE_ROLE_KEY=CAMBIAR_service_role_key_jwt

# Llaves nuevas (opacas / asimétricas). NO las usamos: déjalas vacías.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_KEYS=
JWT_JWKS=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=

# Acceso a Studio por el gateway (basic auth). Studio igual solo se expone en loopback.
DASHBOARD_USERNAME=admin
#   openssl rand -base64 18
DASHBOARD_PASSWORD=CAMBIAR_dashboard_password

# Clave de Realtime/Supavisor, mínimo 64 caracteres.   openssl rand -base64 48
SECRET_KEY_BASE=CAMBIAR_secret_key_base
# Exactamente 16 caracteres.                           openssl rand -hex 8
REALTIME_DB_ENC_KEY=CAMBIAR_16_chars_hex
# Exactamente 32 caracteres.                           openssl rand -hex 16
VAULT_ENC_KEY=CAMBIAR_32_chars_hex
# Mínimo 32 caracteres.                                openssl rand -base64 24
PG_META_CRYPTO_KEY=CAMBIAR_pg_meta_crypto_key
# Tokens de Logflare (solo importan si STACK_LOGS=true; igual se generan).  openssl rand -base64 24
LOGFLARE_PUBLIC_ACCESS_TOKEN=CAMBIAR_logflare_public
LOGFLARE_PRIVATE_ACCESS_TOKEN=CAMBIAR_logflare_private
# Credenciales del endpoint S3 de Storage.   ID: openssl rand -hex 16   Secreto: openssl rand -hex 32
S3_PROTOCOL_ACCESS_KEY_ID=CAMBIAR_s3_key_id
S3_PROTOCOL_ACCESS_KEY_SECRET=CAMBIAR_s3_key_secret

# =====================================================================================
# URLs  (subdominio público del API; el reverse proxy del VPS lo apunta al gateway)
# =====================================================================================
# Base pública del API (sin barra final). La app usa esta URL + ANON_KEY.
SUPABASE_PUBLIC_URL=https://parejas-api.srv1574981.hstgr.cloud
# URL externa del servicio Auth: en el compose oficial actual lleva /auth/v1 al final.
API_EXTERNAL_URL=https://parejas-api.srv1574981.hstgr.cloud/auth/v1
# Dirección a la que Auth redirige tras confirmar/recuperar. Para una app móvil se usa su
# esquema (deep link). Se ajusta cuando exista el scheme definitivo de la app.
SITE_URL=https://parejas-api.srv1574981.hstgr.cloud
# Lista (separada por comas) de redirecciones permitidas, p. ej. el deep link de la app.
ADDITIONAL_REDIRECT_URLS=

# Host público del API (Traefik enruta por este nombre) y datos del Traefik del VPS.
PAREJAS_API_HOST=parejas-api.srv1574981.hstgr.cloud
# Red Docker a la que está conectado Traefik (el api-gw se une a ella; debe existir).
TRAEFIK_NETWORK=n8n_default
TRAEFIK_CERTRESOLVER=mytlschallenge
# Subred de app-parejas-net (fuera de 172.x para no chocar con otros stacks).
APP_PAREJAS_SUBNET=10.77.0.0/24
# El gateway NO publica puertos en el host (no hay KONG_HTTP_PORT).
# Puerto de Studio en 127.0.0.1 (túnel SSH). Solo loopback.
STUDIO_HOST_PORT=13000
# Solo si STACK_POOLER=true (puertos en 127.0.0.1):
POOLER_HOST_PORT_SESSION=15432
POOLER_HOST_PORT_TRANSACTION=16543

# =====================================================================================
# Base de datos
# =====================================================================================
POSTGRES_HOST=db
POSTGRES_DB=postgres
# Puerto INTERNO de Postgres en la red del stack (no se publica al host).
POSTGRES_PORT=5432

# Pooler (Supavisor). Solo se usa con STACK_POOLER=true; el compose oficial exige las variables.
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=app-parejas
POOLER_DB_POOL_SIZE=5

# =====================================================================================
# Studio
# =====================================================================================
STUDIO_DEFAULT_ORGANIZATION=App Parejas
STUDIO_DEFAULT_PROJECT=App Parejas
# Vacío: sin asistente de IA.
OPENAI_API_KEY=

# =====================================================================================
# Auth
# =====================================================================================
JWT_EXPIRY=3600
# Poner en true cuando los DOS ya se hayan registrado (cierra el registro público).
# Después basta recrear Auth:  source scripts/server/lib.sh && compose up -d auth
DISABLE_SIGNUP=false
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"
ENABLE_EMAIL_SIGNUP=true
# Sin SMTP: los correos se confirman solos. (Sin SMTP tampoco hay "olvidé mi contraseña".)
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
# SMTP: valores de relleno (no se envía correo). Si algún día se configura un SMTP real,
# se cambian estos y se pone ENABLE_EMAIL_AUTOCONFIRM=false.
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=localhost
SMTP_PORT=2500
SMTP_USER=no_smtp
SMTP_PASS=no_smtp
SMTP_SENDER_NAME=App Parejas

# =====================================================================================
# Storage
# =====================================================================================
GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=stub
# Lo lee el compose oficial aunque no usemos MinIO.
MINIO_ROOT_USER=supa-storage
MINIO_ROOT_PASSWORD=CAMBIAR_minio_unused
IMGPROXY_AUTO_WEBP=true

# =====================================================================================
# Edge Functions / API
# =====================================================================================
# VERIFY_JWT aplica a TODAS las funciones. Con false cada función valida el JWT por su cuenta
# (notify lo hará). Cámbialo solo si todas las funciones exigen usuario autenticado.
FUNCTIONS_VERIFY_JWT=false
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

# =====================================================================================
# Logs y Analytics (solo con STACK_LOGS=true)
# =====================================================================================
DOCKER_SOCKET_LOCATION=/var/run/docker.sock
GOOGLE_PROJECT_ID=GOOGLE_PROJECT_ID
GOOGLE_PROJECT_NUMBER=GOOGLE_PROJECT_NUMBER

# =====================================================================================
# Límites de memoria por servicio (opcionales; defaults en docker-compose.override.yml,
# suma ~2.75 GB; el VPS no tiene swap, por eso memswap_limit = mem_limit)
# =====================================================================================
#MEM_DB=768m
#MEM_REALTIME=384m
#MEM_STUDIO=384m
#MEM_STORAGE=256m
#MEM_FUNCTIONS=256m
#MEM_AUTH=192m
#MEM_REST=192m
#MEM_META=128m
#MEM_IMGPROXY=128m
#MEM_GATEWAY=128m
#MEM_POOLER=384m
#MEM_ANALYTICS=768m
#MEM_VECTOR=192m

# Secretos de Edge Functions (FCM, etc.) van en OTRO archivo, no aquí:
#   /opt/app-parejas/secrets/functions.env   (formato KEY=VALOR, chmod 600)
#FUNCTIONS_ENV_FILE=/opt/app-parejas/secrets/functions.env
