# Ejemplo para nginx (host o contenedor) - App Parejas
# Copiar a /etc/nginx/conf.d/parejas-api.conf (o sites-available), reemplazar el dominio y el
# puerto (KONG_HTTP_PORT), y recargar:  nginx -t && systemctl reload nginx
# Certificado: certbot --nginx -d parejas-api.TU-DOMINIO.com  (o el método que ya uses en el VPS).
#
# Si nginx corre en un CONTENEDOR, 127.0.0.1 es el propio contenedor: usa
# host.docker.internal (con extra_hosts host-gateway) o la IP del bridge (172.17.0.1).

# Necesario para WebSocket (Realtime): "Connection: upgrade" solo cuando hay Upgrade.
map $http_upgrade $conexion_ws {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name parejas-api.TU-DOMINIO.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name parejas-api.TU-DOMINIO.com;

    ssl_certificate     /etc/letsencrypt/live/parejas-api.TU-DOMINIO.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/parejas-api.TU-DOMINIO.com/privkey.pem;

    # Fotos/audios de Storage (el límite de Supabase es 50 MB).
    client_max_body_size 55m;

    # Solo se exponen las rutas del API. Studio, /pg (meta) y demás NO salen a Internet.
    location ~ ^/(auth|rest|realtime|storage|functions)/v1/ {
        proxy_pass http://127.0.0.1:18000;   # <- KONG_HTTP_PORT

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket (Realtime)
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $conexion_ws;
        proxy_read_timeout  3600s;
        proxy_send_timeout  3600s;
        proxy_buffering off;
    }

    location / {
        return 404;
    }
}
